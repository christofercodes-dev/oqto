APP_NAME="Oqto ekonomisystem"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
#CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=postmark
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@kortaben.work"
MAIL_FROM_NAME="${APP_NAME}"

# Postmark Server API-token (hittas under Servers > din server > API Tokens
# i Postmark). Används för allt utgående mejl, t.ex. lösenordsåterställning.
POSTMARK_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Integrationer - nattlig import från S3 (se README.md och
# app/Console/Commands/ImportIntegrations.php). En extern .NET-tjänst
# dumpar applications.json + bilder (images/) i den här bucketen varje natt.
# Bucketen är privat - se README.md för hur bilder visas (signed_url-modifiern).
INTEGRATIONS_S3_KEY=
INTEGRATIONS_S3_SECRET=
INTEGRATIONS_S3_REGION=eu-north-1
INTEGRATIONS_S3_BUCKET=
# Om bucketen delas mellan miljöer (t.ex. bucket/production, bucket/staging),
# ange mappnamnet här - prefixas automatiskt på applications.json och images/.
INTEGRATIONS_S3_ROOT_PREFIX=
# Sätts bara om bucketen görs publik (t.ex. via en CDN) - lämna tom annars.
INTEGRATIONS_S3_URL=
INTEGRATIONS_S3_JSON_PATH=applications.json

# Zapier-webhooks som triggas varje gång respektive formulär skickas in
# (se app/Listeners/SendFormSubmissionToZapier.php). Skapa en egen
# "Webhooks by Zapier"-zap (trigger "Catch Hook") per formulär och
# klistra in URL:en den ger dig - en separat zap per rad nedan.
ZAPIER_JOB_APPLICATION_WEBHOOK_URL=
ZAPIER_BOKA_DEMO_WEBHOOK_URL=
ZAPIER_CONTACT_WEBHOOK_URL=
ZAPIER_DEVELOPERS_CONTACT_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"

STATAMIC_LICENSE_KEY=
STATAMIC_PRO_ENABLED=false
STATAMIC_STACHE_WATCHER=auto
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_TWO_FACTOR_ENABLED=true
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GIT_ENABLED=false

DEBUGBAR_ENABLED=false

# Bolagsverket - Värdefulla datamängder (för /boka-demo SNI-uppslag)
# Uppgifter fås via Bolagsverkets kundregistrering, se
# https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/vardefulladatamangder.5294.html
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
BOLAGSVERKET_TOKEN_URI=https://portal.api.bolagsverket.se/oauth2/token
BOLAGSVERKET_BASE_URI=https://gw.api.bolagsverket.se/vardefulla-datamangder/v1
BOLAGSVERKET_SCOPE=vardefulla-datamangder:read
